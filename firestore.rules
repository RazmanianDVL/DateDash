rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - only owner can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Prevent client-side fake verification approval
      allow update: if request.auth.uid == userId 
        && !( 'verificationStatus' in request.resource.data && request.resource.data.verificationStatus == 'approved')
        && !( 'isVerified' in request.resource.data && request.resource.data.isVerified == true);
    }

    // Calls collection for WebRTC signaling
    match /calls/{callId} {
      allow create, read, update, delete: if request.auth != null;
      // TODO: Add more restrictions later (only participants, verified users, etc.)
    }

    // Matching queue (to be used later)
    match /matchingQueue/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
